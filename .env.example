# Copy to .env and set a new random secret before starting the application.
STUDY_RAG_DATABASE_URL=postgresql+asyncpg://study_rag:study_rag@127.0.0.1:5432/study_rag
STUDY_RAG_JWT_SECRET=
STUDY_RAG_JWT_ISSUER=study-rag
STUDY_RAG_JWT_AUDIENCE=study-rag-api
STUDY_RAG_EMBEDDING_BACKEND=ollama
STUDY_RAG_OLLAMA_URL=http://127.0.0.1:11434
STUDY_RAG_OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
STUDY_RAG_GENERATION_MODEL=qwen3.5:4b
STUDY_RAG_TOKENIZER_MODEL=Qwen/Qwen3.5-4B
STUDY_RAG_UPLOAD_DIRECTORY=.data/uploads
STUDY_RAG_QDRANT_DIRECTORY=.data/qdrant
STUDY_RAG_MODEL_CACHE_DIRECTORY=.data/models
# Set this only when running a Qdrant server. Leave unset for embedded local mode.
# STUDY_RAG_QDRANT_URL=http://127.0.0.1:6333
# Optional gated HF backend, after accepting the Gemma licence and authenticating HF.
# STUDY_RAG_EMBEDDING_BACKEND=huggingface
# STUDY_RAG_EMBEDDING_DEVICE=mps
